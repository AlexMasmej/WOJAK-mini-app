# Google AI Studio API Key (get it from aistudio.google.com/apikey)
# SECURITY: This key is transmitted via secure headers, not in URLs
GOOGLE_API_KEY=your-api-key

# Rate Limiting (optional - defaults provided)
# Per-minute request limit to prevent burst abuse
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# Daily Generation Limit (optional - default 5)
# Maximum number of new image generations per user per day (resets at midnight UTC)
# Cache hits don't count toward this limit
DAILY_GENERATION_LIMIT=5

# Cache TTL in seconds (optional - default 300)
CACHE_TTL_SECONDS=300
