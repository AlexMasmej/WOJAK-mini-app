# ============================================
# Option 1: Vertex AI (recommended - higher rate limits)
# ============================================
# Get API key from Google Cloud Console > APIs & Services > Credentials
# Restrict the key to "Vertex AI API"
VERTEX_API_KEY=your-vertex-api-key
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ============================================
# Option 2: Google AI Studio (simpler setup, lower limits)
# ============================================
# Get API key from aistudio.google.com/apikey
# Only used if VERTEX_API_KEY is not set
GOOGLE_API_KEY=your-api-key

# Rate Limiting (optional - defaults provided)
# Per-minute request limit to prevent burst abuse
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# Daily Generation Limit (optional - default 5)
# Maximum number of new image generations per user per day (resets at midnight UTC)
# Cache hits don't count toward this limit
DAILY_GENERATION_LIMIT=5

# Cache TTL in seconds (optional - default 86400 = 24 hours)
# Same image + settings = same result, so long cache is safe
CACHE_TTL_SECONDS=86400
